rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return hasUserDoc()
        && userDoc().status == "active"
        && userDoc().roles.superAdmin == true;
    }

    function myOrgId() {
      return hasUserDoc() ? userDoc().orgId : null;
    }






function isOrgOwner(orgId) {
  return isActiveOrgMember(orgId)
    && orgMemberDoc(orgId).role == "orgOwner";
}

function isOrgMember(orgId) {
  return request.auth != null
    && exists(
      /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)
    );
}

function orgMemberDoc(orgId) {
  return get(
    /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)
  ).data;
}

function isActiveOrgMember(orgId) {
  return hasUserDoc()
    && userDoc().status == "active"
    && myOrgId() == orgId
    && exists(/databases/$(database)/documents/orgs/$(orgId))
    && get(/databases/$(database)/documents/orgs/$(orgId)).data.status == "active"
    && isOrgMember(orgId)
    && orgMemberDoc(orgId).status == "active"
    && orgMemberDoc(orgId).active == true
    && orgMemberDoc(orgId).role is string;
}

function isOrgAdmin(orgId) {
  return isActiveOrgMember(orgId)
    && orgMemberDoc(orgId).role == "orgAdmin";
}

function isOrgOwnerOrAdmin(orgId) {
  return isOrgOwner(orgId) || isOrgAdmin(orgId) || isSuperAdmin();
}

function canManageOrgInvitations(orgId) {
  return isSuperAdmin()
    || isOrgOwner(orgId)
    || (
      isActiveOrgMember(orgId)
      && orgMemberDoc(orgId).role == "orgAdmin"
    );
}

function invitationDoc(orgId, invitationId) {
  return get(
    /databases/$(database)/documents/orgs/$(orgId)/invitations/$(invitationId)
  ).data;
}

function acceptedInvitationAfterWrite(orgId, invitationId, memberUid) {
  return exists(/databases/$(database)/documents/orgs/$(orgId)/invitations/$(invitationId))
    && invitationDoc(orgId, invitationId).status == "pending"
    && invitationDoc(orgId, invitationId).superAdminApprovalStatus == "approved"
    && invitationDoc(orgId, invitationId).email == request.auth.token.email
    && invitationDoc(orgId, invitationId).role == request.resource.data.role
    && getAfter(
      /databases/$(database)/documents/orgs/$(orgId)/invitations/$(invitationId)
    ).data.status == "accepted"
    && getAfter(
      /databases/$(database)/documents/orgs/$(orgId)/invitations/$(invitationId)
    ).data.acceptedBy == memberUid;
}

function orgDoc(orgId) {
  return get(/databases/$(database)/documents/orgs/$(orgId)).data;
}

function orgHasCachedUserCapacity(orgId) {
  return !exists(/databases/$(database)/documents/orgs/$(orgId))
    || orgDoc(orgId).maxUsers == null
    || orgDoc(orgId).activeMemberCount == null
    || orgDoc(orgId).activeMemberCount < orgDoc(orgId).maxUsers;
}

function validAcceptedInvitationMembership(orgId, invitationId, memberUid) {
  return isSignedIn()
    && request.auth.uid == memberUid
    && request.resource.data.invitationId is string
    && request.resource.data.status == "active"
    && request.resource.data.active == true
    && request.resource.data.superAdmin == false
    && request.resource.data.role in ["orgAdmin", "contributor", "viewer", "assessor"]
    && orgHasCachedUserCapacity(orgId)
    && acceptedInvitationAfterWrite(orgId, invitationId, memberUid);
}

function validPendingRegistrationUser(uid) {
  return request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      "uid", "email", "displayName", "status", "requestedLevel", "registrationSource", "createdAt"
    ])
    && request.resource.data.uid == uid
    && request.resource.data.status == "pending"
    && request.resource.data.email is string
    && request.resource.data.displayName is string
    && request.resource.data.requestedLevel in ["SPONSORED", "COMM_L1", "COMM_L2"]
    && request.resource.data.registrationSource == "self_registration";
}

function validAcceptedInvitationUser(uid) {
  let orgId = request.resource.data.orgId;
  let member = getAfter(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid)).data;
  let invitation = getAfter(/databases/$(database)/documents/orgs/$(orgId)/invitations/$(member.invitationId)).data;
  return request.auth.uid == uid
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "uid", "displayName", "fullName", "email", "phone", "orgId", "status", "roles", "updatedAt"
    ])
    && request.resource.data.status == "active"
    && request.resource.data.roles.superAdmin != true
    && member.status == "active"
    && member.active == true
    && member.role == request.resource.data.roles.orgRole
    && invitation.status == "accepted"
    && invitation.acceptedBy == uid
    && invitation.email == request.auth.token.email;
}

function validAcceptedInvitationUserCreate(uid) {
  let orgId = request.resource.data.orgId;
  let member = getAfter(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid)).data;
  let invitation = getAfter(/databases/$(database)/documents/orgs/$(orgId)/invitations/$(member.invitationId)).data;
  return request.auth.uid == uid
    && request.resource.data.keys().hasOnly([
      "uid", "displayName", "fullName", "email", "phone", "orgId", "status", "roles", "updatedAt"
    ])
    && request.resource.data.uid == uid
    && request.resource.data.status == "active"
    && request.resource.data.roles.superAdmin != true
    && member.status == "active"
    && member.active == true
    && member.role == request.resource.data.roles.orgRole
    && invitation.status == "accepted"
    && invitation.acceptedBy == uid
    && invitation.email == request.auth.token.email;
}

function canReadAssessmentData(orgId) {
  return isSuperAdmin() || isActiveOrgMember(orgId);
}

function canWriteAssessmentShell(orgId) {
  return isSuperAdmin()
    || (
      isActiveOrgMember(orgId)
      && orgMemberDoc(orgId).role in ["orgOwner", "orgAdmin", "assessor", "contributor"]
    );
}

function canReadActivityEvents(orgId) {
  return isSuperAdmin()
    || (
      isActiveOrgMember(orgId)
      && orgMemberDoc(orgId).role in ["orgOwner", "orgAdmin"]
    );
}

function validActivityEventCreate() {
  let orgId = request.resource.data.orgId;
  return isSignedIn()
    && request.resource.data.keys().hasOnly([
      "orgId", "orgName", "action", "actorUid", "actorEmail", "actorName",
      "targetType", "targetId", "targetLabel", "summary", "metadata", "createdAt"
    ])
    && request.resource.data.actorUid == request.auth.uid
    && request.resource.data.action is string
    && request.resource.data.summary is string
    && request.resource.data.createdAt == request.time
    && orgId is string
    && (
      isSuperAdmin()
      || (
        isActiveOrgMember(orgId)
        && myOrgId() == orgId
      )
    );
}

function validPilotFeedbackCreate() {
  let orgId = request.resource.data.orgId;
  return isSignedIn()
    && request.resource.data.keys().hasOnly([
      "orgId", "orgName", "uid", "userEmail", "userName", "role",
      "category", "message", "page", "status", "createdAt", "updatedAt"
    ])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.category in ["Bug", "Feature Request", "Question", "Other"]
    && request.resource.data.message is string
    && request.resource.data.status == "new"
    && request.resource.data.createdAt == request.time
    && request.resource.data.updatedAt == request.time
    && (
      isSuperAdmin()
      || (
        orgId is string
        && isActiveOrgMember(orgId)
        && myOrgId() == orgId
      )
    );
}

function validPilotFeedbackStatusUpdate() {
  return isSuperAdmin()
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "status", "updatedAt", "reviewedByUid"
    ])
    && request.resource.data.status in ["new", "reviewed", "closed"]
    && request.resource.data.updatedAt == request.time
    && request.resource.data.reviewedByUid == request.auth.uid;
}




    function isMyOrg(orgId) {
      return hasUserDoc() && myOrgId() == orgId;
    }

// --- system config (super admin only) ---
    match /system/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Firestore document paths require the immutable cleanup entries subcollection.
    match /system/cleanupActivity/entries/{activityId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /activityEvents/{eventId} {
      allow read: if canReadActivityEvents(resource.data.orgId);
      allow create: if validActivityEventCreate();
      allow update, delete: if false;
    }

    match /pilotFeedback/{feedbackId} {
      allow read: if isSuperAdmin();
      allow create: if validPilotFeedbackCreate();
      allow update: if validPilotFeedbackStatusUpdate();
      allow delete: if false;
    }


// --- user profiles ---
// --- users ---
match /users/{uid} {
  allow read: if request.auth != null
    && (request.auth.uid == uid || isSuperAdmin());

  allow create: if isSuperAdmin()
    || (isSignedIn() && (
      validPendingRegistrationUser(uid)
      || validAcceptedInvitationUserCreate(uid)
    ));

  allow update: if isSuperAdmin()
    || (isSignedIn() && validAcceptedInvitationUser(uid))
    || (
      isSignedIn()
      && request.auth.uid == uid
      && resource.data.status == "active"
      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
        "displayName", "fullName", "phone", "title", "updatedAt"
      ])
    );

  allow delete: if false;
}


// --- orgs ---
match /orgs/{orgId} {

  // READ org:
  // - super admin
  // - org owner (bootstrap safe)
  // - org member
  allow read: if isSuperAdmin() || isActiveOrgMember(orgId);

  // WRITE org:
  // - super admin only (MVP rule)
  allow create, update, delete: if isSuperAdmin();


// ✅ Update allowed for owner/orgAdmin BUT only for safe fields
  allow update: if isOrgOwnerOrAdmin(orgId)
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      "name",
      "address",
      "phone",
      "website",
      "primaryContactName",
      "primaryContactEmail",
      "primaryContactPhone",
      "secondaryContactName",
      "secondaryContactEmail",
      "secondaryContactPhone",
      "logoUrl",
      "companyProfile",
      "companyProfileUpdatedAt",
      "companyProfileUpdatedBy"
    ]);



  // --- org members subcollection ---
  match /members/{memberUid} {

    // READ members list:
    // - super admin
    // - org owner
    // - org members
    allow read: if isSuperAdmin() || isActiveOrgMember(orgId)
      || (isSignedIn() && request.auth.uid == memberUid);

    allow create: if isSuperAdmin()
      || (
        validAcceptedInvitationMembership(orgId, request.resource.data.invitationId, memberUid)
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "fullName", "phone", "role", "status", "active", "superAdmin", "email", "invitationId", "joinedAt", "createdAt", "updatedAt"
        ])
      );
    allow update: if isSuperAdmin()
      || (
        validAcceptedInvitationMembership(orgId, request.resource.data.invitationId, memberUid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "uid", "displayName", "fullName", "phone", "role", "status", "active", "superAdmin", "email", "invitationId", "joinedAt", "createdAt", "updatedAt"
        ])
      ) || (
        isSignedIn()
        && request.auth.uid == memberUid
        && isActiveOrgMember(orgId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName", "fullName", "phone", "title", "updatedAt"
        ])
      );
    allow delete: if isSuperAdmin();
  }

  match /invitations/{invitationId} {
    allow read: if canManageOrgInvitations(orgId)
      || (
        isSignedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email
      );

    allow create: if canManageOrgInvitations(orgId)
      && orgHasCachedUserCapacity(orgId)
      && request.resource.data.keys().hasOnly([
        "id", "orgId", "orgName", "email", "fullName", "role", "status", "invitedBy", "invitedByUid", "invitedByName", "invitedByEmail", "invitedByDisplay", "invitedAt"
      ])
      && request.resource.data.id == invitationId
      && request.resource.data.orgId == orgId
      && request.resource.data.email is string
      && request.resource.data.role in ["orgAdmin", "contributor", "viewer", "assessor"]
      && request.resource.data.status == "pending"
      && request.resource.data.invitedBy == request.auth.uid;

    allow update: if (
        canManageOrgInvitations(orgId)
        && resource.data.status == "pending"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status", "cancelledBy", "cancelledAt"
        ])
        && request.resource.data.status == "cancelled"
        && request.resource.data.cancelledBy == request.auth.uid
      ) || (
        isSignedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email
        && resource.data.status == "pending"
        && resource.data.superAdminApprovalStatus == "approved"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status", "acceptedBy", "acceptedAt"
        ])
        && request.resource.data.status == "accepted"
        && request.resource.data.acceptedBy == request.auth.uid
      );

    allow delete: if false;
  }

  // --- assessment shell (Phase 4A) ---
  match /assessments/{assessmentId} {
    allow read: if canReadAssessmentData(orgId);
    allow create, update: if canWriteAssessmentShell(orgId);
    allow delete: if false;

    match /practiceRecords/{practiceId} {
      allow read: if canReadAssessmentData(orgId);
      allow create, update: if canWriteAssessmentShell(orgId);
      allow delete: if false;

      match /evidenceRefs/{evidenceId} {
        allow read: if canReadAssessmentData(orgId);
        allow create, update: if canWriteAssessmentShell(orgId);
        allow delete: if false;
      }

      match /evidenceValidations/{evidenceId} {
        allow read: if canReadAssessmentData(orgId);
        allow write: if false;
      }

      match /copilot/{copilotId} {
        allow read: if canReadAssessmentData(orgId);
        allow write: if false;
      }
    }

    match /objectiveRecords/{objectiveId} {
      allow read: if canReadAssessmentData(orgId);
      allow create, update: if canWriteAssessmentShell(orgId);
      allow delete: if false;

      match /evidenceRefs/{evidenceId} {
        allow read: if canReadAssessmentData(orgId);
        allow create, update: if canWriteAssessmentShell(orgId);
        allow delete: if false;
      }

      match /evidenceValidations/{evidenceId} {
        allow read: if canReadAssessmentData(orgId);
        allow write: if false;
      }
    }

    match /poamItems/{poamId} {
      allow read: if canReadAssessmentData(orgId);
      allow create, update: if canWriteAssessmentShell(orgId);
      allow delete: if false;
    }

    match /scoreSnapshots/{snapshotId} {
      allow read: if canReadAssessmentData(orgId);
      allow create: if canWriteAssessmentShell(orgId);
      allow update, delete: if false;
    }

    match /activityLog/{activityId} {
      allow read: if canReadAssessmentData(orgId);
      allow create: if canWriteAssessmentShell(orgId);
      allow update, delete: if false;
    }
  }

  match /evidence/{evidenceId} {
    allow read: if canReadAssessmentData(orgId);
    allow create, update: if canWriteAssessmentShell(orgId);
    allow delete: if false;
  }

  match /evidenceLibrary/{evidenceId} {
    allow read: if canReadAssessmentData(orgId);
    allow create, update: if canWriteAssessmentShell(orgId);
    allow delete: if false;
  }

  match /notes/{noteId} {
    allow read: if canReadAssessmentData(orgId);
    allow create, update: if canWriteAssessmentShell(orgId);
    allow delete: if false;
  }
}

    // --- org members ---
match /orgMembers/{orgId}/members/{memberUid} {
  allow read: if isSuperAdmin() || isActiveOrgMember(orgId);

  // ✅ SuperAdmin can create membership even when org is being created
  // in the same transaction (org doc may not "exist" during rules eval).
  allow create: if isSuperAdmin()
    && orgHasCachedUserCapacity(orgId);

  allow update, delete: if isSuperAdmin();
}






// --- access requests (admin inbox) ---
// Docs:
// - orgRegistration: { type:"orgRegistration", status:"pending", requestedTier, orgName, primaryContactName, ... , requestedByUid, ownerEmail, createdAt }
// - addUser: { type:"addUser", orgId, fullName, email, requestedRole, status:"pending", requestedByUid, createdAt }
// - upgradeRequest: { type:"upgradeRequest", orgId, requestedTier, status:"pending", requestedByUid, createdAt }
match /accessRequests/{reqId} {

  // SuperAdmin reads the full inbox. Org owner/admin can read only their org requests.
  allow read: if isSuperAdmin()
    || (
      hasUserDoc()
      && resource.data.orgId == myOrgId()
      && (isOrgOwner(myOrgId()) || isOrgAdmin(myOrgId()))
    );

  // ✅ Allow first-time registrants (no userDoc/org yet) to create orgRegistration
  allow create: if isSignedIn()
    && request.resource.data.type == "orgRegistration"
    && request.resource.data.status == "pending"
    && request.resource.data.requestedByUid == request.auth.uid
    // basic required fields (keeps junk out)
    && request.resource.data.orgName is string
    && request.resource.data.requestedTier is string
    && request.resource.data.primaryContactName is string
    && request.resource.data.ownerEmail is string;

  // ✅ Existing org admin/owner requests (addUser / upgradeRequest) — requires userDoc + org membership
  allow create: if hasUserDoc()
    && (request.resource.data.type in ["addUser", "upgradeRequest"])
    && (isOrgOwner(myOrgId()) || isOrgAdmin(myOrgId()))
    && request.resource.data.orgId == myOrgId()
    && request.resource.data.status == "pending"
    && request.resource.data.requestedByUid == request.auth.uid;

  // Only super admin updates status / approves
  allow update: if isSuperAdmin();

  // MVP: no deletes
  allow delete: if false;
}








    // --- usage (org-scoped) ---
    match /usageDaily/{docId} {
      // docId pattern: orgId_YYYYMMDD
      allow read: if isSuperAdmin()
        || (hasUserDoc() && userDoc().status == "active" && docId.startsWith(myOrgId() + "_"));

      // MVP: only super admin writes usage until gateway exists
      allow write: if isSuperAdmin();
    }

    match /usageEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
